{
  "name": "after-hours",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "After Hours — liminal-space walking simulator (multiple spaces: park, school, ...)",
  "scripts": {
    "dev": "node scripts/dev-server.mjs start",
    "dev:restart": "node scripts/dev-server.mjs restart",
    "dev:bg": "node scripts/dev-server.mjs bg",
    "dev:stop": "node scripts/dev-server.mjs stop",
    "dev:status": "node scripts/dev-server.mjs status",
    "dev:fix": "node scripts/dev-server.mjs fix",
    "build": "node scripts/check-spaces.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "cap:sync": "npm run build && npx cap sync",
    "electron:dev": "electron electron/main.cjs",
    "perf:report": "node scripts/perf-checkpoint.mjs",
    "assets:build": "node scripts/build-assets.mjs build",
    "assets:watch": "node scripts/build-assets.mjs --watch",
    "check:spaces": "node scripts/check-spaces.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.2",
    "@react-three/drei": "^10.7.4",
    "@react-three/fiber": "^9.3.0",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.1.0",
    "howler": "^2.2.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "seedrandom": "^3.0.5",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/cli": "^7.4.2",
    "@capacitor/ios": "^7.4.2",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/howler": "^2.2.12",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/seedrandom": "^3.0.8",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^37.2.6",
    "meshoptimizer": "^1.3.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.2"
  }
}
